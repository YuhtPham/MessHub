
{
  "name": "messhub-desktop",
  "version": "1.6.1",
  "description": "MessHub desktop workspace for Zalo, Messenger, and other messaging accounts.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",

    "test": "npm run test:syntax && npm run test:deps",
    "test:syntax": "node --check src/main/index.js",
    "test:syntax:all": "find src scripts -type f -name '*.js' -exec node --check {} \\;",
    "test:deps": "npm ls --depth=0",
    "test:build": "npm run build",
    "test:all": "npm run test:syntax:all && npm run test:deps && npm run build",

    "build": "electron-builder --linux",
    "postbuild": "node scripts/clean-build-output.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.tiodev.meta9",
    "productName": "MessHub Client",
    "directories": {
      "output": "."
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "category": "Network",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/icons/windows-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "icon": "assets/icons/app-icon.png",
      "category": "public.app-category.social-networking"
    },
    "dmg": {
      "title": "MessHub Client",
      "artifactName": "MessHub-Client-${version}-mac.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MessHub Client",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/icons/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "YuhtPham",
        "repo": "MessHub"
      }
    ]
  },
  "keywords": [
    "MessHub",
    "multi-account",
    "desktop",
    "electron"
  ],
  "author": "Tiodev71",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
